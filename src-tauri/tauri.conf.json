{
  "productName": "InterForge",
  "version": "0.1.0",
  "identifier": "com.interforge.studio",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "withGlobalTauri": false,

    "windows": [
      {
        "label": "main",
        "title": "InterForge",
        "width": 1200,
        "height": 760,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": true
      }
    ],

    "security": {
      "csp": null
    }
  },

  "plugins": {
    "shell": {
      "open": "^.+$"
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    "macOS": {
      "minimumSystemVersion": "10.13"
    },

    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },

    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
